# Copy this file to ".env" (same folder) and adjust the values.
# ".env" is ignored by Git. NEVER commit real secrets in this file.
# All values below are fake and for local development only.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=nailbook
POSTGRES_USER=nailbook
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432